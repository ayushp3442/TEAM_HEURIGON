# Server & Environment
PORT=8080
APP_ENV=production
APP_TIME_ZONE=Asia/Kolkata

# Database configuration
# In local Docker Compose: jdbc:postgresql://db:5432/peertutor
# In Railway: jdbc:postgresql://${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DB_URL=
DB_USER=
DB_PASS=

# JPA / Hibernate
SHOW_SQL=false
DDL_AUTO=update

# Security (JWT secret: must be at least 32 characters in production, 64+ recommended)
JWT_SECRET=

# CORS (Origins allowed to access the backend API)
# Local frontend: http://localhost:3000
# Production frontend: https://<your-app>.vercel.app
CORS_ORIGINS=
CORS_ORIGIN_PATTERNS=
