# Database configuration (within docker compose, service name is 'db')
DB_URL=jdbc:postgresql://db:5432/peertutor
DB_USER=postgres
DB_PASS=postgres

# Security
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars!!

# CORS
CORS_ORIGINS=http://localhost:3000

# Time Zone
APP_TIME_ZONE=Asia/Kolkata
